use std::process::Command;

const CLAUDE_BIN: &str = "/opt/homebrew/bin/claude";

const PROJECT_DIR: &str = "/Volumes/백업/AI/AI-Character";

fn claude_args(prompt: &str) -> Vec<String> {
    vec!["-p".to_string(), prompt.to_string()]
}

#[tauri::command]
async fn ask_claude(prompt: String) -> Result<String, String> {
    let prompt = prompt.trim().to_string();

    if prompt.is_empty() {
        return Err("메시지가 비어 있습니다.".to_string());
    }

    let result = tauri::async_runtime::spawn_blocking(move || {
        let output = Command::new(CLAUDE_BIN)
            .args(claude_args(&prompt))
            .current_dir(PROJECT_DIR)
            .env("NO_COLOR", "1")
            .output()
            .map_err(|error| format!("Claude 실행 실패: {}", error))?;

        if !output.status.success() {
            let stderr = String::from_utf8_lossy(&output.stderr).trim().to_string();

            return Err(format!(
                "Claude 오류: {}",
                if stderr.is_empty() {
                    "알 수 없는 오류"
                } else {
                    &stderr
                }
            ));
        }

        let answer = String::from_utf8_lossy(&output.stdout).trim().to_string();

        if answer.is_empty() {
            return Err("Claude 응답이 비어 있습니다.".to_string());
        }

        Ok(answer)
    })
    .await
    .map_err(|error| format!("Claude 작업 실행 오류: {}", error))?;

    result
}

fn parse_process_stats(output: &str) -> Result<(f64, f64), String> {
    let mut values = output.split_whitespace();

    let cpu_percent = values
        .next()
        .ok_or("CPU 정보가 없습니다.")?
        .parse::<f64>()
        .map_err(|error| format!("CPU 파싱 실패: {}", error))?;

    let rss_kb = values
        .next()
        .ok_or("RAM 정보가 없습니다.")?
        .parse::<f64>()
        .map_err(|error| format!("RAM 파싱 실패: {}", error))?;

    Ok((cpu_percent, rss_kb / 1024.0))
}

#[tauri::command]
async fn get_process_stats() -> Result<Vec<f64>, String> {
    let pid = std::process::id().to_string();

    let result = tauri::async_runtime::spawn_blocking(move || {
        let output = Command::new("/bin/ps")
            .args(["-p", pid.as_str(), "-o", "%cpu=", "-o", "rss="])
            .env("LC_ALL", "C")
            .output()
            .map_err(|error| format!("ps 실행 실패: {}", error))?;

        if !output.status.success() {
            return Err("프로세스 정보를 읽지 못했습니다.".to_string());
        }

        let text = String::from_utf8_lossy(&output.stdout);

        let (cpu, memory_mb) = parse_process_stats(&text)?;

        Ok(vec![cpu, memory_mb])
    })
    .await
    .map_err(|error| format!("성능 조회 작업 실패: {}", error))?;

    result
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn claude_uses_print_mode() {
        let args = claude_args("안녕");

        assert_eq!(args, vec!["-p".to_string(), "안녕".to_string(),]);
    }
}

#[cfg(test)]
mod process_stats_tests {
    use super::*;

    #[test]
    fn parses_process_stats() {
        let (cpu, memory_mb) = parse_process_stats(" 12.5 153600\n").unwrap();

        assert_eq!(cpu, 12.5);

        assert_eq!(memory_mb, 150.0);
    }
}

#[cfg_attr(mobile, tauri::mobile_entry_point)]
pub fn run() {
    tauri::Builder::default()
        .plugin(tauri_plugin_opener::init())
        .invoke_handler(tauri::generate_handler![ask_claude, get_process_stats])
        .run(tauri::generate_context!())
        .expect("error while running tauri application");
}
