{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Character",
  "version": "0.1.4",
  "identifier": "local.ai.character",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "AI Character",
        "width": 280,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "label": "main",
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "minWidth": 160,
        "minHeight": 160
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**",
          "$APPDATA/live2d-models/**",
          "$APPLOCALDATA/live2d-models/**",
          "$APPDATA/**/live2d-models/**",
          "$APPDATA/local.ai.character/live2d-models/**",
          "$APPDATA/AI-Character/live2d-models/**",
          "$HOME/Library/Application Support/AI-Character/live2d-models/**",
          "$HOME/Library/Application Support/local.ai.character/live2d-models/**"
        ]
      },
      "csp": "default-src 'self' asset: https://asset.localhost http://asset.localhost https://tauri.localhost tauri:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; font-src 'self' data:; connect-src 'self' blob: data: ipc: http://ipc.localhost https://ipc.localhost asset: http://asset.localhost https://asset.localhost https://tauri.localhost tauri: http://127.0.0.1:* http://localhost:*; worker-src 'self' blob: data:; media-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/wch0798/ai-character/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/live2d/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
