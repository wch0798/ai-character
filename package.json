{
  "name": "ai-character",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "node --require ./tools/patch-styletext.cjs ./node_modules/vite/bin/vite.js",
    "build": "tsc && node --require ./tools/patch-styletext.cjs ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "tauri": "tauri",
    "start": "node tools/launch.mjs",
    "start:dev": "npm run tauri -- dev",
    "stop": "node tools/launch.mjs stop",
    "setup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/setup-windows.ps1",
    "setup:window": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/setup-windows.ps1",
    "build:app": "bash tools/build-release-macos.sh",
    "build:app:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-release-windows.ps1",
    "install:local": "bash tools/install-local-macos.sh",
    "install:local:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/install-local-windows.ps1",
    "start:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/launch-ai-character.ps1",
    "verify:security": "python3 tools/verify-security-baseline.py .",
    "verify:windows-install": "python tools/verify-windows-auto-install.py .",
    "test": "node --require ./tools/patch-styletext.cjs ./node_modules/vitest/vitest.mjs run"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@laplace.live/pixijs-live2d": "^0.4.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  }
}
