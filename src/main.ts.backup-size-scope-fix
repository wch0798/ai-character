import "./styles.css";

import {
  Application,
  Ticker,
} from "pixi.js";

import {
  Live2DModel,
} from "@laplace.live/pixijs-live2d";

import {
  getCurrentWindow,
} from "@tauri-apps/api/window";

import {
  buildMotionChoices,
} from "./motion-menu";

async function startLive2D() {
  const canvas =
    document.querySelector<HTMLCanvasElement>(
      "#live2d-canvas"
    );

  const status =
    document.querySelector<HTMLDivElement>(
      "#status"
    );

  const chatPanel =
    document.querySelector<HTMLDivElement>(
      "#chat-panel"
    );

  const chatForm =
    document.querySelector<HTMLFormElement>(
      "#chat-form"
    );

  const chatInput =
    document.querySelector<HTMLInputElement>(
      "#chat-input"
    );

  const messages =
    document.querySelector<HTMLDivElement>(
      "#messages"
    );

  if (!canvas) {
    throw new Error("Live2D canvas 없음");
  }

  let playCurrentMotion:
    ((
      group: string,
      index?: number
    ) => void)
    | null = null;

  /*
   * 2단 우클릭 메뉴
   */
  window.addEventListener(
    "contextmenu",
    async (event) => {
      event.preventDefault();
      event.stopImmediatePropagation();

      let menu =
        document.querySelector<HTMLDivElement>(
          "#rightclick-test-menu"
        );

      if (!menu) {
        menu = document.createElement("div");
        menu.id = "rightclick-test-menu";

        menu.style.position = "fixed";
        menu.style.width = "170px";
        menu.style.padding = "7px";
        menu.style.borderRadius = "12px";
        menu.style.background =
          "rgba(25, 25, 30, 0.97)";
        menu.style.color = "white";
        menu.style.fontSize = "13px";
        menu.style.zIndex = "99999";
        menu.style.boxShadow =
          "0 8px 28px rgba(0,0,0,0.40)";

        document.body.appendChild(menu);
      }

      menu.innerHTML = "";

      /*
       * 2단 메뉴
       * main menu의 자식으로 넣기 때문에
       * 기존 outside-click 처리와 충돌하지 않음
       */
      const submenu =
        document.createElement("div");

      submenu.id =
        "rightclick-submenu";

      submenu.style.position =
        "fixed";

      submenu.style.display =
        "none";

      submenu.style.width =
        "210px";

      submenu.style.padding =
        "7px";

      submenu.style.borderRadius =
        "12px";

      submenu.style.background =
        "rgba(30, 30, 36, 0.98)";

      submenu.style.color =
        "white";

      submenu.style.fontSize =
        "13px";

      submenu.style.zIndex =
        "100000";

      submenu.style.boxShadow =
        "0 8px 28px rgba(0,0,0,0.45)";

      submenu.style.overflowY =
        "auto";

      submenu.style.maxHeight =
        `${Math.max(
          180,
          window.innerHeight - 16
        )}px`;

      menu.appendChild(submenu);


      const makeButton = (
        text: string,
        onClick: () => void,
        arrow = false
      ) => {
        const button =
          document.createElement("button");

        button.type = "button";

        button.style.display = "flex";
        button.style.alignItems = "center";
        button.style.justifyContent =
          "space-between";

        button.style.width = "100%";
        button.style.margin = "3px 0";
        button.style.padding = "8px 9px";

        button.style.border = "0";
        button.style.borderRadius = "8px";

        button.style.background =
          "rgba(255,255,255,0.08)";

        button.style.color = "white";

        button.style.textAlign = "left";

        button.style.cursor = "pointer";

        const label =
          document.createElement("span");

        label.textContent = text;

        button.appendChild(label);

        if (arrow) {
          const rightArrow =
            document.createElement("span");

          rightArrow.textContent = "▶";
          rightArrow.style.opacity = "0.6";
          rightArrow.style.fontSize = "10px";

          button.appendChild(
            rightArrow
          );
        }

        button.addEventListener(
          "mouseenter",
          () => {
            button.style.background =
              "rgba(255,255,255,0.17)";
          }
        );

        button.addEventListener(
          "mouseleave",
          () => {
            button.style.background =
              "rgba(255,255,255,0.08)";
          }
        );

        button.addEventListener(
          "click",
          (clickEvent) => {
            clickEvent.stopPropagation();
            onClick();
          }
        );

        return button;
      };


      const placeSubmenu = () => {
        /*
         * 먼저 표시해서 실제 높이를 측정
         */
        submenu.style.visibility =
          "hidden";

        submenu.style.display =
          "block";

        const rootRect =
          menu!.getBoundingClientRect();

        const submenuWidth = 224;

        const canOpenRight =
          rootRect.right +
            submenuWidth +
            6 <=
          window.innerWidth;

        const left =
          canOpenRight
            ? rootRect.right + 5
            : Math.max(
                5,
                rootRect.left -
                  submenuWidth -
                  5
              );

        const wantedHeight =
          Math.min(
            submenu.scrollHeight,
            window.innerHeight - 16
          );

        const top =
          Math.max(
            8,
            Math.min(
              rootRect.top,
              window.innerHeight -
                wantedHeight -
                8
            )
          );

        submenu.style.left =
          `${left}px`;

        submenu.style.top =
          `${top}px`;

        submenu.style.visibility =
          "visible";
      };


      const showCharacterMenu =
        async () => {
          submenu.innerHTML = "";

          const response =
            await fetch(
              "/live2d/models/models.json"
            );

          const characters =
            (await response.json()) as Array<{
              id: string;
              name: string;
              model: string;
              motions: Record<string, number>;
            }>;

          const selectedModel =
            localStorage.getItem(
              "selected-live2d-model"
            );

          for (
            const character
            of characters
          ) {
            const selected =
              character.model ===
              selectedModel;

            const button =
              makeButton(
                selected
                  ? `✓ ${character.name}`
                  : character.name,
                () => {
                  localStorage.setItem(
                    "selected-live2d-model",
                    character.model
                  );

                  localStorage.setItem(
                    "selected-live2d-name",
                    character.name
                  );

                  menu!.style.display =
                    "none";

                  window.location.reload();
                }
              );

            submenu.appendChild(
              button
            );
          }

          placeSubmenu();
        };


      const showMotionMenu =
        async () => {
          submenu.innerHTML = "";

          const response =
            await fetch(
              "/live2d/models/models.json"
            );

          const characters =
            (await response.json()) as Array<{
              id: string;
              name: string;
              model: string;
              motions: Record<string, number>;
            }>;

          const selectedModel =
            localStorage.getItem(
              "selected-live2d-model"
            ) ??
            "/live2d/models/Hiyori/Hiyori.model3.json";

          const character =
            characters.find(
              (item) =>
                item.model ===
                selectedModel
            )
            ??
            characters.find(
              (item) =>
                item.id === "Hiyori"
            )
            ??
            characters[0];

          const title =
            document.createElement(
              "div"
            );

          title.textContent =
            character
              ? `${character.name} 행동`
              : "행동";

          title.style.padding =
            "5px 7px 7px";

          title.style.fontSize =
            "11px";

          title.style.opacity =
            "0.6";

          submenu.appendChild(
            title
          );

          const motionChoices =
            buildMotionChoices(
              character?.motions ?? {}
            );

          if (
            motionChoices.length === 0
          ) {
            const empty =
              document.createElement(
                "div"
              );

            empty.textContent =
              "등록된 행동이 없습니다.";

            empty.style.padding =
              "8px";

            empty.style.opacity =
              "0.6";

            submenu.appendChild(
              empty
            );
          }

          for (
            const motion
            of motionChoices
          ) {
            const button =
              makeButton(
                motion.label,
                () => {
                  playCurrentMotion?.(
                    motion.group,
                    motion.index
                  );

                  menu!.style.display =
                    "none";
                }
              );

            submenu.appendChild(
              button
            );
          }

          placeSubmenu();
        };


      /*
       * 크기 2단 메뉴
       */
      const showSizeMenu =
        () => {
          submenu.innerHTML = "";

          const title =
            document.createElement(
              "div"
            );

          title.textContent =
            "캐릭터 크기";

          title.style.padding =
            "5px 7px 7px";

          title.style.fontSize =
            "11px";

          title.style.opacity =
            "0.6";

          submenu.appendChild(
            title
          );

          const sizes = [
            {
              id: "tiny",
              label: "아주 작게",
            },
            {
              id: "small",
              label: "작게",
            },
            {
              id: "medium",
              label: "보통",
            },
            {
              id: "large",
              label: "크게",
            },
          ] as const;

          for (
            const size
            of sizes
          ) {
            const selected =
              selectedSize ===
              size.id;

            const button =
              makeButton(
                selected
                  ? `✓ ${size.label}`
                  : size.label,
                () => {
                  applyCharacterSize(
                    size.id
                  );

                  submenu.style.display =
                    "none";

                  menu!.style.display =
                    "none";

                  if (status) {
                    status.textContent =
                      `크기: ${size.label}`;

                    status.classList.remove(
                      "hidden"
                    );

                    window.setTimeout(
                      () => {
                        status.classList.add(
                          "hidden"
                        );
                      },
                      900
                    );
                  }
                }
              );

            submenu.appendChild(
              button
            );
          }

          placeSubmenu();
        };


      /*
       * 1단 메뉴
       */
      const characterButton =
        makeButton(
          "캐릭터 변경",
          () => {
            void showCharacterMenu();
          },
          true
        );

      /*
       * 마우스를 올리기만 해도
       * 2단 메뉴 표시
       */
      characterButton.addEventListener(
        "pointerenter",
        () => {
          void showCharacterMenu();
        }
      );


      const motionButton =
        makeButton(
          "행동",
          () => {
            void showMotionMenu();
          },
          true
        );

      motionButton.addEventListener(
        "pointerenter",
        () => {
          void showMotionMenu();
        }
      );


      const sizeButton =
        makeButton(
          "크기",
          () => {
            showSizeMenu();
          },
          true
        );

      sizeButton.addEventListener(
        "pointerenter",
        () => {
          showSizeMenu();
        }
      );


      const chatButton =
        makeButton(
          "채팅 열기",
          () => {
            chatPanel?.classList.add(
              "open"
            );

            menu!.style.display =
              "none";

            window.setTimeout(
              () => {
                chatInput?.focus();
              },
              50
            );
          }
        );


      menu.appendChild(
        characterButton
      );

      menu.appendChild(
        motionButton
      );

      menu.appendChild(
        sizeButton
      );

      menu.appendChild(
        chatButton
      );


      /*
       * 1단 메뉴 위치
       */
      menu.style.visibility =
        "hidden";

      menu.style.display =
        "block";

      submenu.style.display =
        "none";

      const rootWidth = 184;

      const left =
        Math.max(
          5,
          Math.min(
            event.clientX,
            window.innerWidth -
              rootWidth
          )
        );

      const rootHeight =
        menu.scrollHeight;

      const top =
        Math.max(
          5,
          Math.min(
            event.clientY,
            window.innerHeight -
              rootHeight -
              5
          )
        );

      menu.style.left =
        `${left}px`;

      menu.style.top =
        `${top}px`;

      menu.style.visibility =
        "visible";
    },
    true
  );

  const app = new Application();

  await app.init({
    canvas,
    resizeTo: window,
    backgroundAlpha: 0,
    antialias: true,
  });

  Live2DModel.registerTicker(Ticker);

  const selectedModel =
    localStorage.getItem(
      "selected-live2d-model"
    ) ??
    "/live2d/models/Hiyori/Hiyori.model3.json";

  console.log(
    "선택된 캐릭터:",
    selectedModel
  );

  const model =
    await Live2DModel.from(
      selectedModel
    );

  app.stage.addChild(model);

  /*
   * 우클릭 메뉴에서 선택한
   * 실제 Live2D 행동 실행
   */
  playCurrentMotion = (
    group: string,
    index?: number
  ) => {
    console.log(
      "MOTION:",
      group,
      index
    );

    void model
      .motion(
        group,
        index,
        3
      )
      .then((played) => {
        console.log(
          "MOTION RESULT:",
          group,
          index,
          played
        );

        if (status) {
          status.textContent =
            `${group} ${
              index === undefined
                ? "랜덤"
                : index + 1
            } / 실행=${played}`;

          status.classList.remove(
            "hidden"
          );

          window.setTimeout(
            () => {
              status.classList.add(
                "hidden"
              );
            },
            1000
          );
        }
      })
      .catch((error) => {
        console.error(
          "모션 실행 실패:",
          error
        );
      });
  };

  /*
   * 캐릭터 기본 크기
   * 숫자를 작게 할수록 캐릭터가 작아짐.
   */
  const maxCharacterWidth = window.innerWidth * 0.72;
  const maxCharacterHeight = window.innerHeight * 0.78;

  let characterScale = Math.min(
    maxCharacterWidth / model.width,
    maxCharacterHeight / model.height
  );

  /*
   * 캐릭터 위치
   */
  let characterX =
    window.innerWidth * 0.5;

  let characterY =
    window.innerHeight - 10;

  model.anchor.set(0.5, 1);
  model.scale.set(characterScale);

  model.position.set(
    characterX,
    characterY
  );

  /*
   * 마우스 이벤트 활성화
   */
  model.eventMode = "static";
  model.cursor = "grab";

  let pointerDown = false;
  let moved = false;
  let nativeDragStarted = false;

  let pointerStartX = 0;
  let pointerStartY = 0;

  model.on("pointerdown", (event) => {
    pointerDown = true;
    moved = false;
    nativeDragStarted = false;

    pointerStartX = event.global.x;
    pointerStartY = event.global.y;

    model.cursor = "grabbing";
  });

  model.on("globalpointermove", async (event) => {
    if (!pointerDown || nativeDragStarted) {
      return;
    }

    const dx =
      event.global.x - pointerStartX;

    const dy =
      event.global.y - pointerStartY;

    const distance =
      Math.hypot(dx, dy);

    // 단순 클릭과 드래그를 구분
    if (distance < 6) {
      return;
    }

    moved = true;
    nativeDragStarted = true;

    try {
      // Live2D 모델이 아니라 Mac 창 자체를 이동
      await getCurrentWindow().startDragging();
    } catch (error) {
      console.error(
        "창 드래그 실패:",
        error
      );
    }
  });

  const stopDragging = () => {
    pointerDown = false;
    nativeDragStarted = false;
    model.cursor = "grab";
  };

  model.on("pointerup", stopDragging);
  model.on("pointerupoutside", stopDragging);

  /*
   * 클릭하면:
   * - 채팅창 열기
   * - TapBody 모션
   */
  model.on("pointertap", async () => {
    if (moved) return;

    chatPanel?.classList.toggle("open");

    try {
      await model.motion("TapBody", undefined, 3);
    } catch (error) {
      console.warn(
        "TapBody motion:",
        error
      );
    }
  });

  /*
   * Idle 모션 시작
   */
  try {
    model.motion("Idle", undefined, 1);
  } catch (error) {
    console.warn(
      "Idle motion:",
      error
    );
  }

  /*
   * 마우스 휠로 캐릭터 크기 조절
   */
  canvas.addEventListener(
    "wheel",
    (event) => {
      event.preventDefault();

      if (event.deltaY < 0) {
        characterScale += 0.01;
      } else {
        characterScale -= 0.01;
      }

      characterScale =
        Math.max(
          0.08,
          Math.min(
            0.4,
            characterScale
          )
        );

      model.scale.set(
        characterScale
      );

      if (status) {
        status.textContent =
          `크기 ${Math.round(
            characterScale * 100
          )}%`;

        status.classList.remove(
          "hidden"
        );

        setTimeout(() => {
          status.classList.add(
            "hidden"
          );
        }, 700);
      }
    },
    {
      passive: false,
    }
  );

  /*
   * 채팅
   */
  function addMessage(
    text: string,
    type: "user" | "assistant"
  ) {
    if (!messages) return;

    const bubble =
      document.createElement("div");

    bubble.className =
      `message ${type}`;

    bubble.textContent = text;

    messages.appendChild(bubble);

    messages.scrollTop =
      messages.scrollHeight;
  }

  chatForm?.addEventListener(
    "submit",
    (event) => {
      event.preventDefault();

      const text =
        chatInput?.value.trim();

      if (!text) return;

      addMessage(
        text,
        "user"
      );

      if (chatInput) {
        chatInput.value = "";
      }

      /*
       * 아직 Claude 연결 전이므로
       * 테스트 응답만 표시
       */
      setTimeout(() => {
        addMessage(
          "메시지를 받았어요. 다음 단계에서 Claude Code와 연결할게요.",
          "assistant"
        );

        try {
          model.motion("TapBody", undefined, 3);
        } catch {
          // ignore
        }
      }, 300);
    }
  );

  if (status) {
    status.textContent =
      "캐릭터를 클릭하면 채팅창이 열립니다";

    setTimeout(() => {
      status.classList.add(
        "hidden"
      );
    }, 2500);
  }

  console.log(
    "Live2D UI ready"
  );
}

startLive2D().catch(
  (error) => {
    console.error(
      "Live2D 시작 실패:",
      error
    );

    const status =
      document.querySelector<HTMLDivElement>(
        "#status"
      );

    if (status) {
      status.textContent =
        "Live2D 로딩 실패";

      status.classList.add(
        "error"
      );
    }
  }
);

document.addEventListener("pointerdown", (event) => {
  const menu =
    document.querySelector<HTMLElement>(
      "#rightclick-test-menu"
    );

  if (!menu) {
    return;
  }

  const target = event.target as Node;

  // 메뉴 내부를 누른 경우에는 닫지 않는다.
  // 캐릭터 선택 버튼의 click 이벤트가 정상 실행되도록 한다.
  if (menu.contains(target)) {
    return;
  }

  menu.style.display = "none";
});
