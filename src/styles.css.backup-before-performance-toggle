#perf-hud {
  position: absolute;

  top: 8px;
  right: 8px;

  padding: 6px 8px;

  border-radius: 9px;

  background:
    rgba(10, 12, 16, 0.68);

  color:
    rgba(255, 255, 255, 0.88);

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;

  font-size: 10px;
  line-height: 1.45;

  white-space: nowrap;

  pointer-events: none;

  z-index: 9999;

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

#perf-hud.hidden {
  display: none;
}


/* -------------------------
   Performance HUD
------------------------- */

#performance-hud {
  position: absolute;

  top: 10px;
  left: 10px;

  padding:
    5px 8px;

  border-radius: 9px;

  background:
    rgba(15, 17, 22, 0.72);

  backdrop-filter:
    blur(8px);

  -webkit-backdrop-filter:
    blur(8px);

  color:
    rgba(255, 255, 255, 0.88);

  font-size: 10px;
  line-height: 1.2;

  font-variant-numeric:
    tabular-nums;

  white-space: nowrap;

  z-index: 40;

  pointer-events: none;
}
