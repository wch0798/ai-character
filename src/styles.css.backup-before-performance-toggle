html,
body,
#app {
  margin: 0;
  padding: 0;

  width: 100%;
  height: 100%;

  overflow: hidden;

  background: transparent !important;
}

body {
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  user-select: none;
  -webkit-user-select: none;
}

#app {
  position: relative;
}

#live2d-canvas {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  display: block;

  background: transparent;

  z-index: 1;
}


/* -------------------------
   채팅창
------------------------- */

#chat-panel {
  position: absolute;

  left: 12px;
  right: 12px;
  bottom: 12px;

  height: 160px;

  display: flex;
  flex-direction: column;

  border-radius: 16px;

  background:
    rgba(20, 22, 28, 0.94);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter:
    blur(18px);

  box-shadow:
    0 8px 32px
    rgba(0, 0, 0, 0.32);

  z-index: 30;

  opacity: 0;

  transform:
    translateY(18px);

  pointer-events: none;

  transition:
    opacity .18s ease,
    transform .18s ease;
}

#chat-panel.open {
  opacity: 1;

  transform:
    translateY(0);

  pointer-events: auto;
}

#messages {
  flex: 1;

  padding: 12px;

  overflow-y: auto;

  display: flex;
  flex-direction: column;

  gap: 8px;
}

.message {
  max-width: 82%;

  padding:
    8px 11px;

  border-radius: 13px;

  font-size: 13px;
  line-height: 1.4;

  color: white;
}

.message.assistant {
  align-self: flex-start;

  background:
    rgba(255,255,255,.13);
}

.message.user {
  align-self: flex-end;

  background:
    rgba(75,115,255,.85);
}

#chat-form {
  display: flex;

  gap: 7px;

  padding: 9px;

  border-top:
    1px solid rgba(255,255,255,.08);
}

#chat-input {
  flex: 1;

  min-width: 0;

  border: none;
  outline: none;

  padding:
    9px 11px;

  border-radius: 11px;

  background:
    rgba(255,255,255,.12);

  color: white;

  font-size: 13px;
}

#chat-input::placeholder {
  color:
    rgba(255,255,255,.5);
}

#chat-form button {
  border: 0;

  padding:
    0 13px;

  border-radius: 11px;

  cursor: pointer;
}


/* -------------------------
   우클릭 메뉴
------------------------- */

.context-menu {
  position: absolute;

  display: none;

  width: 245px;

  max-height: 470px;

  overflow-y: auto;

  padding: 8px;

  border:
    1px solid rgba(255,255,255,.12);

  border-radius: 15px;

  background:
    rgba(24,26,32,.96);

  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);

  box-shadow:
    0 10px 40px rgba(0,0,0,.4);

  color: white;

  z-index: 100;
}

.context-menu.open {
  display: block;
}

.menu-title {
  padding:
    7px 8px 4px;

  font-size: 11px;

  color:
    rgba(255,255,255,.55);

  font-weight: 600;
}

.menu-grid {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 5px;

  padding:
    4px;
}

.menu-button {
  border: 0;

  padding:
    8px 7px;

  border-radius: 9px;

  text-align: left;

  cursor: pointer;

  color: white;

  background:
    rgba(255,255,255,.075);

  font-size: 12px;
}

.menu-button:hover {
  background:
    rgba(255,255,255,.16);
}

.menu-button.active {
  background:
    rgba(80,120,255,.65);
}

.menu-wide {
  grid-column:
    1 / -1;
}

.menu-divider {
  height: 1px;

  margin:
    7px 5px;

  background:
    rgba(255,255,255,.09);
}


/* -------------------------
   상태 메시지
------------------------- */

#status {
  position: absolute;

  top: 15px;
  left: 50%;

  transform:
    translateX(-50%);

  padding:
    6px 11px;

  border-radius: 15px;

  background:
    rgba(20,20,25,.8);

  color: white;

  font-size: 11px;

  white-space: nowrap;

  pointer-events: none;

  z-index: 120;

  transition:
    opacity .25s ease;
}

#status.hidden {
  opacity: 0;
}

#status.error {
  background:
    rgba(155,20,20,.9);
}

