html,
body,
#app {
  margin: 0;
  padding: 0;

  width: 100%;
  height: 100%;

  overflow: hidden;

  background: transparent !important;
}

body {
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  user-select: none;
  -webkit-user-select: none;
}

#app {
  position: relative;
}

#live2d-canvas {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  display: block;

  background: transparent;

  z-index: 1;
}


/* -------------------------
   채팅창
------------------------- */

#chat-panel {
  position: absolute;

  left: 12px;
  right: 12px;
  bottom: 12px;

  height: 160px;

  display: flex;
  flex-direction: column;

  border-radius: 16px;

  background:
    rgba(20, 22, 28, 0.94);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter:
    blur(18px);

  box-shadow:
    0 8px 32px
    rgba(0, 0, 0, 0.32);

  z-index: 30;

  opacity: 0;

  transform:
    translateY(18px);

  pointer-events: none;

  transition:
    opacity .18s ease,
    transform .18s ease;
}

#chat-panel.open {
  opacity: 1;

  transform:
    translateY(0);

  pointer-events: auto;
}

#messages {
  flex: 1;

  padding: 12px;

  overflow-y: auto;

  display: flex;
  flex-direction: column;

  gap: 8px;
}

.message {
  max-width: 82%;

  padding:
    8px 11px;

  border-radius: 13px;

  font-size: 13px;
  line-height: 1.4;

  color: white;
}

.message.assistant {
  align-self: flex-start;

  background:
    rgba(255,255,255,.13);
}

.message.user {
  align-self: flex-end;

  background:
    rgba(75,115,255,.85);
}

#chat-form {
  display: flex;

  gap: 7px;

  padding: 9px;

  border-top:
    1px solid rgba(255,255,255,.08);
}

#chat-input {
  flex: 1;

  min-width: 0;

  border: none;
  outline: none;

  padding:
    9px 11px;

  border-radius: 11px;

  background:
    rgba(255,255,255,.12);

  color: white;

  font-size: 13px;
}

#chat-input::placeholder {
  color:
    rgba(255,255,255,.5);
}

#chat-form button {
  border: 0;

  padding:
    0 13px;

  border-radius: 11px;

  cursor: pointer;
}


/* -------------------------
   우클릭 메뉴
------------------------- */

.context-menu {
  position: absolute;

  display: none;

  width: 245px;

  max-height: 470px;

  overflow-y: auto;

  padding: 8px;

  border:
    1px solid rgba(255,255,255,.12);

  border-radius: 15px;

  background:
    rgba(24,26,32,.96);

  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);

  box-shadow:
    0 10px 40px rgba(0,0,0,.4);

  color: white;

  z-index: 100;
}

.context-menu.open {
  display: block;
}

.menu-title {
  padding:
    7px 8px 4px;

  font-size: 11px;

  color:
    rgba(255,255,255,.55);

  font-weight: 600;
}

.menu-grid {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 5px;

  padding:
    4px;
}

.menu-button {
  border: 0;

  padding:
    8px 7px;

  border-radius: 9px;

  text-align: left;

  cursor: pointer;

  color: white;

  background:
    rgba(255,255,255,.075);

  font-size: 12px;
}

.menu-button:hover {
  background:
    rgba(255,255,255,.16);
}

.menu-button.active {
  background:
    rgba(80,120,255,.65);
}

.menu-wide {
  grid-column:
    1 / -1;
}

.menu-divider {
  height: 1px;

  margin:
    7px 5px;

  background:
    rgba(255,255,255,.09);
}


/* -------------------------
   상태 메시지
------------------------- */

#status {
  position: absolute;

  top: 15px;
  left: 50%;

  transform:
    translateX(-50%);

  padding:
    6px 11px;

  border-radius: 15px;

  background:
    rgba(20,20,25,.8);

  color: white;

  font-size: 11px;

  white-space: nowrap;

  pointer-events: none;

  z-index: 120;

  transition:
    opacity .25s ease;
}

#status.hidden {
  opacity: 0;
}

#status.error {
  background:
    rgba(155,20,20,.9);
}

/* AI CHARACTER CONTEXT MENU */

.context-menu {
  position: absolute;
  display: none;

  width: 235px;
  max-height: 440px;

  overflow-y: auto;

  padding: 8px;

  border-radius: 14px;

  background: rgba(24, 26, 32, 0.96);

  border:
    1px solid
    rgba(255, 255, 255, 0.12);

  box-shadow:
    0 10px 35px
    rgba(0, 0, 0, 0.4);

  color: white;

  z-index: 9999;
}

.context-menu.open {
  display: block;
}

.menu-title {
  padding: 7px 6px 4px;

  font-size: 11px;
  font-weight: 600;

  color:
    rgba(255, 255, 255, 0.6);
}

.menu-grid {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 5px;

  padding: 4px;
}

.menu-button {
  border: none;

  padding: 8px 7px;

  border-radius: 9px;

  background:
    rgba(255, 255, 255, 0.09);

  color: white;

  font-size: 12px;

  cursor: pointer;
}

.menu-button:hover {
  background:
    rgba(255, 255, 255, 0.18);
}

.menu-button.active {
  background:
    rgba(75, 115, 255, 0.75);
}

.menu-wide {
  grid-column:
    1 / -1;
}

.menu-divider {
  height: 1px;

  margin: 7px 5px;

  background:
    rgba(255, 255, 255, 0.1);
}

#perf-hud {
  position: absolute;

  top: 8px;
  right: 8px;

  padding: 6px 8px;

  border-radius: 9px;

  background:
    rgba(10, 12, 16, 0.68);

  color:
    rgba(255, 255, 255, 0.88);

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;

  font-size: 10px;
  line-height: 1.45;

  white-space: nowrap;

  pointer-events: none;

  z-index: 9999;

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

#perf-hud.hidden {
  display: none;
}


/* -------------------------
   Performance HUD
------------------------- */

#performance-hud {
  position: absolute;

  top: 0;
  left: 0;

  transform:
    translateX(-50%);

  padding:
    5px 8px;

  border-radius: 9px;

  background:
    rgba(15, 17, 22, 0.72);

  backdrop-filter:
    blur(8px);

  -webkit-backdrop-filter:
    blur(8px);

  color:
    rgba(255, 255, 255, 0.88);

  font-size: 10px;
  line-height: 1.2;

  font-variant-numeric:
    tabular-nums;

  white-space: nowrap;

  z-index: 40;

  pointer-events: none;
}


/* =========================
   Chat attachments
   ========================= */

#attachment-list {
  display: none;
  gap: 6px;
  padding: 4px 6px;
  overflow-x: auto;
  flex-shrink: 0;
}

#attachment-list.has-files {
  display: flex;
}

.attachment-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  max-width: 180px;

  padding: 4px 6px;

  border-radius: 8px;

  background:
    rgba(255, 255, 255, 0.12);

  font-size: 10px;

  white-space: nowrap;
}

.attachment-name {
  overflow: hidden;
  text-overflow: ellipsis;
}

.attachment-remove {
  appearance: none;

  border: 0;
  padding: 0 2px;

  background: transparent;
  color: inherit;

  cursor: pointer;

  font-size: 14px;
  line-height: 1;
}

#attachment-button {
  flex: 0 0 auto;

  width: 30px;
  min-width: 30px;

  font-size: 18px;
  font-weight: 500;
}


/* =====================================
   Resizable chat / copy / drag-drop
   ===================================== */

#chat-panel {
  min-height: 160px;
  max-height: calc(100vh - 70px);
}

#chat-resize-handle {
  flex: 0 0 10px;

  position: relative;

  cursor: ns-resize;
  touch-action: none;

  user-select: none;
  -webkit-user-select: none;
}

#chat-resize-handle::after {
  content: "";

  position: absolute;

  left: 50%;
  top: 4px;

  width: 44px;
  height: 3px;

  transform:
    translateX(-50%);

  border-radius: 999px;

  background:
    rgba(255,255,255,.30);
}

#messages {
  min-height: 0;
}

.message {
  position: relative;

  padding-bottom: 25px;
}

.message-text {
  white-space: pre-wrap;

  overflow-wrap: anywhere;

  user-select: text;
  -webkit-user-select: text;

  cursor: text;
}

.message-copy {
  position: absolute;

  right: 7px;
  bottom: 5px;

  border: 0;

  padding: 2px 6px;

  border-radius: 6px;

  font-size: 9px;

  color:
    rgba(255,255,255,.72);

  background:
    rgba(0,0,0,.18);

  cursor: pointer;
}

.message-copy:hover {
  background:
    rgba(0,0,0,.32);
}

#chat-panel.file-drag-over {
  outline:
    2px solid
    rgba(110,160,255,.9);

  box-shadow:
    0 0 0 4px
    rgba(80,130,255,.16),
    0 8px 32px
    rgba(0,0,0,.32);
}

.attachment-chip {
  max-width: 260px;
}

.attachment-access {
  flex: 0 0 auto;

  font-size: 8px;

  opacity: .78;
}

/* -------------------------
   채팅 기록 / 새 채팅
------------------------- */

#chat-history-toolbar {
  flex: 0 0 auto;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 8px;

  padding:
    7px 9px 5px;
}

#chat-history-toolbar button {
  border: 0;

  min-height: 28px;

  padding:
    0 10px;

  border-radius: 9px;

  color:
    rgba(255,255,255,.90);

  background:
    rgba(255,255,255,.08);

  font-size: 11px;
  font-weight: 600;

  cursor: pointer;
}

#chat-history-toolbar button:hover {
  background:
    rgba(255,255,255,.14);
}

#new-chat-button {
  margin-left: auto;
}

#chat-history-drawer {
  position: absolute;

  inset: 7px;

  z-index: 90;

  display: none;
  flex-direction: column;

  gap: 8px;

  padding: 10px;

  border:
    1px solid rgba(255,255,255,.08);

  border-radius: 14px;

  background:
    rgba(18,20,25,.985);

  box-shadow:
    0 12px 40px rgba(0,0,0,.40);

  backdrop-filter: blur(20px);
  -webkit-backdrop-filter:
    blur(20px);
}

#chat-history-drawer.open {
  display: flex;
}

#chat-history-drawer-header {
  flex: 0 0 auto;

  display: flex;
  align-items: center;
  justify-content: space-between;

  min-height: 30px;
}

#chat-history-drawer-title {
  padding-left: 3px;

  color:
    rgba(255,255,255,.94);

  font-size: 13px;
  font-weight: 700;
}

#chat-history-close {
  width: 28px;
  height: 28px;

  border: 0;
  border-radius: 8px;

  color:
    rgba(255,255,255,.74);

  background: transparent;

  font-size: 18px;

  cursor: pointer;
}

#chat-history-close:hover {
  color: white;

  background:
    rgba(255,255,255,.09);
}

#chat-history-search {
  flex: 0 0 auto;

  width: 100%;
  box-sizing: border-box;

  border:
    1px solid rgba(255,255,255,.07);

  outline: 0;

  padding:
    8px 10px;

  border-radius: 9px;

  color: white;

  background:
    rgba(255,255,255,.07);

  font-size: 11px;
}

#chat-history-search:focus {
  border-color:
    rgba(110,150,255,.42);

  background:
    rgba(255,255,255,.10);
}

#chat-history-list {
  flex: 1;
  min-height: 0;

  overflow-y: auto;

  display: flex;
  flex-direction: column;

  gap: 4px;

  padding-right: 1px;
}

.chat-history-row {
  position: relative;

  display: grid;

  grid-template-columns:
    minmax(0,1fr) 28px;

  gap: 4px;

  align-items: center;

  border-radius: 9px;
}

.chat-history-row.active {
  background:
    rgba(85,120,255,.15);
}

.chat-history-open {
  min-width: 0;

  border: 0;

  padding:
    8px 9px;

  border-radius: 9px;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;

  color:
    rgba(255,255,255,.90);

  background: transparent;

  text-align: left;
  font-size: 11px;

  cursor: pointer;
}

.chat-history-open:hover {
  background:
    rgba(255,255,255,.06);
}

.chat-history-more {
  width: 28px;
  height: 28px;

  border: 0;
  border-radius: 8px;

  color:
    rgba(255,255,255,.68);

  background: transparent;

  font-size: 16px;
  line-height: 1;

  cursor: pointer;
}

.chat-history-more:hover,
.chat-history-more.open {
  color: white;

  background:
    rgba(255,255,255,.10);
}

.chat-history-row-menu {
  position: absolute;

  top: 31px;
  right: 0;

  z-index: 2;

  display: none;

  min-width: 92px;

  padding: 4px;

  border:
    1px solid rgba(255,255,255,.08);

  border-radius: 9px;

  background:
    rgba(31,33,40,.99);

  box-shadow:
    0 8px 24px rgba(0,0,0,.36);
}

.chat-history-row-menu.open {
  display: flex;
  flex-direction: column;

  gap: 2px;
}

.chat-history-action {
  border: 0;

  padding:
    7px 8px;

  border-radius: 7px;

  color:
    rgba(255,255,255,.84);

  background: transparent;

  text-align: left;
  font-size: 10px;

  cursor: pointer;
}

.chat-history-action:hover {
  background:
    rgba(255,255,255,.09);
}

.chat-history-action.danger {
  color:
    rgba(255,135,135,.95);
}

#chat-history-delete-all {
  flex: 0 0 auto;

  border: 0;

  padding:
    7px 8px;

  border-radius: 8px;

  color:
    rgba(255,125,125,.88);

  background: transparent;

  font-size: 10px;

  cursor: pointer;
}

#chat-history-delete-all:hover {
  background:
    rgba(190,55,55,.16);
}
