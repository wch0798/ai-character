import {
  getAttachmentKind,
  isAttachmentAllowed,
  type AttachmentKind,
} from "./attachment";

export type PendingAttachment = {
  path: string;
  name: string;
  kind: AttachmentKind;
};

export function getAttachmentName(
  path: string
): string {
  const normalized =
    path.replace(/\\/g, "/");

  return (
    normalized.split("/").pop() ||
    normalized
  );
}

export function buildPendingAttachments(
  paths: string[]
): PendingAttachment[] {
  const seen = new Set<string>();

  return paths
    .filter((path) => {
      if (seen.has(path)) {
        return false;
      }

      seen.add(path);

      return isAttachmentAllowed(
        getAttachmentName(path)
      );
    })
    .map((path) => {
      const name =
        getAttachmentName(path);

      return {
        path,
        name,
        kind:
          getAttachmentKind(name),
      };
    });
}
