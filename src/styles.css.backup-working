html,
body,
#app {
  margin: 0;
  padding: 0;

  width: 100%;
  height: 100%;

  overflow: hidden;

  background: transparent !important;
}

body {
  user-select: none;
  -webkit-user-select: none;

  background-color: transparent !important;
}

#app {
  position: relative;
}

#live2d-canvas {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  display: block;

  background: transparent;
}

#status {
  position: absolute;

  left: 50%;
  bottom: 24px;

  transform: translateX(-50%);

  padding: 8px 14px;

  border-radius: 18px;

  background: rgba(20, 20, 25, 0.72);

  color: white;

  font-family:
    -apple-system,
    BlinkMacSystemFont,
    sans-serif;

  font-size: 13px;

  pointer-events: none;

  transition:
    opacity 0.4s ease;
}

#status.hidden {
  opacity: 0;
}

#status.error {
  background: rgba(150, 20, 20, 0.85);
}
